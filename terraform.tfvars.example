# Exemplo de arquivo de configuração de variáveis
# Copie este arquivo para terraform.tfvars e ajuste os valores conforme necessário

# Configurações gerais
aws_region    = "us-east-1"
environment   = "dev"
project_name  = "wordpress-infra"

# Configurações de rede
vpc_cidr = "10.0.0.0/16"

# Subnets públicas (para Load Balancer/NAT Gateway)
public_subnets = [
  {
    name              = "public-1"
    cidr              = "10.0.1.0/24"
    availability_zone = "us-east-1a"
  },
  {
    name              = "public-2"
    cidr              = "10.0.2.0/24"
    availability_zone = "us-east-1b"
  }
]

# Subnets privadas (para EC2 WordPress)
private_subnets = [
  {
    name              = "private-1"
    cidr              = "10.0.3.0/24"
    availability_zone = "us-east-1a"
  },
  {
    name              = "private-2"
    cidr              = "10.0.4.0/24"
    availability_zone = "us-east-1b"
  }
]

# Subnets de banco de dados (para RDS MySQL)
database_subnets = [
  {
    name              = "database-1"
    cidr              = "10.0.5.0/24"
    availability_zone = "us-east-1a"
  },
  {
    name              = "database-2"
    cidr              = "10.0.6.0/24"
    availability_zone = "us-east-1b"
  }
]

# Configurações do banco de dados
db_username = "wpuser"
db_password = "CHANGE_ME_STRONG_PASSWORD"  # Altere para uma senha forte!
